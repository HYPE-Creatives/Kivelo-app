{
  "name": "kivelo-backend",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    
    "migrate:child-settings": "node scripts/run-migration.js",
    "migrate:batch": "node scripts/run-migration.js --batch-size 200",
    "migrate:prod": "set NODE_ENV=production&& node scripts/run-migration.js",
    "migrate:ps": "powershell -ExecutionPolicy Bypass -File scripts/migrate.ps1",
    "migrate:bat": "scripts\\migrate.bat",
    "db:verify": "node scripts/verify-migration.js"
  },
